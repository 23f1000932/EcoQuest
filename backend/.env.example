# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret

# Gemini AI
GEMINI_API_KEY=AIza...

# App
# --- Development (SQLite) ---
DATABASE_URL=sqlite+aiosqlite:///./ecoquest.db
# --- Production (Supabase PostgreSQL) ---
# Get from: Supabase Dashboard → Project Settings → Database → Connection string → URI
# Then replace "postgres://" with "postgresql+asyncpg://"
# DATABASE_URL=postgresql+asyncpg://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

SECRET_KEY=change-me-to-a-random-32-char-string-please
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
MAX_DAILY_UPLOADS=10
AI_CONFIDENCE_THRESHOLD=70
ADMIN_EMAIL=admin@ecoquest.in
